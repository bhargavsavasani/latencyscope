<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the directories LatencyScope writes reports into are shared. Nothing
  else in the app's storage is exposed through this provider.

  All three are needed, because a report can land in any of them:
    - cache-path          share() / shareAsync(), which default to cacheDir
    - external-files-path LatencyNotification's default, chosen because it is
                          reachable over `adb pull` without a permission

  There is deliberately no files-path: when external storage is unavailable
  LatencyNotification falls back to cacheDir, which is already covered here,
  rather than to filesDir, which would need a third root.

  Leaving a root out does not fail at write time — it fails later, when the
  file is handed to another app and FileProvider cannot map it back.
-->
<paths>
    <cache-path name="latencyscope_reports" path="latencyscope/" />
    <external-files-path name="latencyscope_external" path="latencyscope/" />
</paths>
