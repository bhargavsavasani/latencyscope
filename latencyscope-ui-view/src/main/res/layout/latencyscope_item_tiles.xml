<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/latencyscope_bg_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/latencyscope_tiles_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/latencyscope_text_primary" />

    <TextView
        android:id="@+id/latencyscope_tiles_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:textColor="@color/latencyscope_text_secondary" />

    <TextView
        android:id="@+id/latencyscope_tiles_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:textSize="13sp"
        android:textColor="@color/latencyscope_warn" />
</LinearLayout>
