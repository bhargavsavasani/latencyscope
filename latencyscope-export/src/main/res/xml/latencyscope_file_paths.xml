<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the one directory LatencyScope writes reports into is shared. Nothing
  else in the app's storage is exposed through this provider.

  Both roots describe the same path, `files/report`, in the two places it can
  physically be:
    - external-files-path  where reports always go
    - files-path           the fallback when the device has no external volume

  Declaring a root is not optional bookkeeping. A report written outside every
  declared root writes perfectly well and only fails later, when it is handed
  to another app and FileProvider cannot map it back to a content:// URI.
-->
<paths>
    <external-files-path name="latencyscope_reports" path="report/" />
    <files-path name="latencyscope_reports_internal" path="report/" />
</paths>
